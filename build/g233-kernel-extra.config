# G233-specific kernel config fragment
# Apply on top of riscv defconfig: make ARCH=riscv defconfig
# Then: cat g233-kernel-extra.config >> .config && make ARCH=riscv olddefconfig

# --- Serial (ns16550) ---
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_MMIO=y
CONFIG_SERIAL_OF_PLATFORM=y

# --- Block & Storage ---
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_BLK_SCSI=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y

# --- VirtIO (MMIO + PCI) ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y

# --- PCIe (GPEX host) ---
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y

# --- Device Tree probe ---
CONFIG_SOC_VIRT=y

# --- RTC (Goldfish) ---
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_GOLDFISH=y

# --- Power management (SiFive Test for reset) ---
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SIFIVE=y

# --- Filesystem basics ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y

# --- Networking (basic) ---
CONFIG_NET=y
CONFIG_INET=y

# --- Misc ---
CONFIG_INPUT=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# Required for SERIAL_AMBA_PL011 if we ever switch back; not needed for ns16550
# CONFIG_ARM_AMBA is NOT available on riscv without COMPILE_TEST
